<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/da_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_android_auto"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/da_brand"
                android:textSize="26sp"
                android:textColor="@color/da_text"
                android:fontFamily="sans-serif-medium" />

            <!-- System Info / Connectivity Mode Pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:background="@drawable/bg_pill_translucent"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/status_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/shape_dot_green"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/connection_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/da_ready"
                    android:textColor="@color/da_text"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Audio Routing Quick Toggle Pill -->
            <LinearLayout
                android:id="@+id/audio_mode_button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_translucent"
                android:paddingHorizontal="14dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/audio_mode_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_da_audio"
                    app:tint="@color/da_accent"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/audio_mode_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/audio_mode_car_bt"
                    android:textColor="@color/da_text"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Theme Toggle -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/theme_toggle_button"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                app:icon="@drawable/ic_da_theme"
                app:iconTint="@color/da_text"
                android:contentDescription="@string/da_theme_settings" />

            <!-- Exit / Car Home Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/exit_button"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/da_close"
                android:textSize="15sp"
                android:textColor="@color/da_muted" />
        </LinearLayout>

        <!-- Connection Quick Glance Bar (Wi-Fi Network, Bluetooth & USB Cable) -->
        <LinearLayout
            android:id="@+id/quick_glance_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Wi-Fi Network Glance Card -->
            <LinearLayout
                android:id="@+id/glance_wifi_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/da_card"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:id="@+id/glance_wifi_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_wifi"
                    app:tint="@color/da_accent"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/glance_wifi_title"
                        android:textSize="11sp"
                        android:textColor="@color/da_muted"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/glance_wifi_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/glance_wifi_disconnected"
                        android:textSize="14sp"
                        android:textColor="@color/da_text"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/glance_wifi_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/shape_dot_grey"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- Bluetooth Glance Card -->
            <LinearLayout
                android:id="@+id/glance_bluetooth_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/da_card"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:id="@+id/glance_bluetooth_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_da_bluetooth"
                    app:tint="@color/da_accent"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/glance_bt_title"
                        android:textSize="11sp"
                        android:textColor="@color/da_muted"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/glance_bluetooth_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/glance_bt_disconnected"
                        android:textSize="14sp"
                        android:textColor="@color/da_text"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/glance_bluetooth_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/shape_dot_grey"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- USB Cable Glance Card -->
            <LinearLayout
                android:id="@+id/glance_usb_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/da_card"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:id="@+id/glance_usb_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_usb_white"
                    app:tint="@color/da_accent"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/glance_usb_title"
                        android:textSize="11sp"
                        android:textColor="@color/da_muted"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/glance_usb_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/glance_usb_disconnected"
                        android:textSize="14sp"
                        android:textColor="@color/da_text"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/glance_usb_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/shape_dot_grey"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>

        <!-- Main Cockpit Split Layout: Two Primary 1-Tap Hero Cards (Wireless + USB) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <!-- LEFT HERO: Wireless Android Auto Card -->
            <LinearLayout
                android:id="@+id/wireless_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:background="@drawable/da_card"
                android:padding="22dp">

                <!-- Tagline & Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/da_wireless"
                    android:textSize="12sp"
                    android:textColor="@color/da_accent"
                    android:letterSpacing="0.14"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/connection_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/da_ready"
                    android:textSize="24sp"
                    android:textColor="@color/da_text"
                    android:fontFamily="sans-serif-medium"
                    android:accessibilityLiveRegion="polite" />

                <!-- Step-by-Step Connection Progress Subtext -->
                <TextView
                    android:id="@+id/connection_step_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/step_1_bt"
                    android:textSize="13sp"
                    android:textColor="@color/da_accent"
                    android:visibility="gone" />

                <!-- Active Phone / Network Info Container -->
                <LinearLayout
                    android:id="@+id/device_info_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/da_card_inner"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:gravity="center_vertical"
                    android:visibility="visible">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_phone"
                        app:tint="@color/da_accent"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/preferred_device_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="@string/da_device"
                        android:textColor="@color/da_text"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/btn_switch_device"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_translucent"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="@string/da_switch_phone"
                        android:textColor="@color/da_accent"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Auto-Connect Countdown Banner -->
                <LinearLayout
                    android:id="@+id/auto_connect_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_pill_translucent"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/auto_connect_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Auto-connecting in 4s…"
                        android:textColor="@color/da_accent"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/btn_cancel_auto_connect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="@string/cancel"
                        android:textColor="@color/da_text"
                        android:textSize="12sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Massive 68dp 1-Tap Wireless CTA -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/wifi_button"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/da_connect_wireless"
                    android:textSize="18sp"
                    android:textAllCaps="false"
                    android:gravity="center"
                    android:textColor="@color/da_background"
                    app:backgroundTint="@color/da_accent"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/ic_android_auto"
                    app:iconTint="@color/da_background"
                    app:iconSize="26dp"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp" />

                <!-- Cancel Connection Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cancel_connect"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:text="@string/cancel_connecting"
                    android:textColor="@color/da_muted"
                    app:icon="@drawable/ic_close_white"
                    app:iconTint="@color/da_muted"
                    app:iconPadding="4dp"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/wifi_hint_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/da_hint"
                    android:textSize="12sp"
                    android:textColor="@color/da_muted"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- RIGHT HERO: USB Android Auto Card -->
            <LinearLayout
                android:id="@+id/usb_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:background="@drawable/da_card"
                android:padding="22dp">

                <!-- Tagline & Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/da_usb_title"
                    android:textSize="12sp"
                    android:textColor="@color/da_accent"
                    android:letterSpacing="0.14"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/usb_connection_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/da_plug_in_usb"
                    android:textSize="24sp"
                    android:textColor="@color/da_text"
                    android:fontFamily="sans-serif-medium"
                    android:accessibilityLiveRegion="polite" />

                <TextView
                    android:id="@+id/usb_step_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/switching_to_android_auto"
                    android:textSize="13sp"
                    android:textColor="@color/da_accent"
                    android:visibility="gone" />

                <!-- Detected USB Device Info Container -->
                <LinearLayout
                    android:id="@+id/usb_device_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/da_card_inner"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:gravity="center_vertical"
                    android:visibility="visible">

                    <ImageView
                        android:id="@+id/usb_status_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/shape_dot_grey"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/usb_device_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="@string/da_no_usb_phone"
                        android:textColor="@color/da_text"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/btn_usb_manage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_translucent"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="@string/da_usb_manage"
                        android:textColor="@color/da_accent"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Massive 68dp 1-Tap USB CTA -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/usb_connect_button"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/da_connect_usb"
                    android:textSize="18sp"
                    android:textAllCaps="false"
                    android:gravity="center"
                    android:textColor="@color/da_background"
                    app:backgroundTint="@color/da_accent"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/ic_usb_white"
                    app:iconTint="@color/da_background"
                    app:iconSize="26dp"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp" />

                <TextView
                    android:id="@+id/usb_hint_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/da_wired_usb_dashboard_hint"
                    android:textSize="12sp"
                    android:textColor="@color/da_muted"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Secondary Actions Row: Phone Hotspot Server Setup + Preferences -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="4dp">

            <!-- 1. Phone Hotspot Mode Card -->
            <LinearLayout
                android:id="@+id/hotspot_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/da_card"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_wifi"
                    app:tint="@color/da_accent"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/da_phone_hotspot"
                        android:textColor="@color/da_text"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/da_phone_hotspot_hint"
                        android:textColor="@color/da_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. Settings & Preferences Card -->
            <LinearLayout
                android:id="@+id/settings_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/da_card"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_settings_white"
                    app:tint="@color/da_accent"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/da_preferences_title"
                        android:textColor="@color/da_text"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/da_preferences_desc"
                        android:textColor="@color/da_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
