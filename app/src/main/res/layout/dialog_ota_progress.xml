<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/ota_progress_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Downloading Update"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <ProgressBar
        android:id="@+id/ota_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:max="100"
        android:indeterminate="true"
        android:progressTint="@color/da_accent"
        android:indeterminateTint="@color/da_accent"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/ota_progress_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connecting to GitHub…"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>
