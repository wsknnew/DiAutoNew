<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/da_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_phone_title"
                    android:textColor="@color/da_text"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/select_phone_subtitle"
                    android:textColor="@color/da_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_refresh_scan"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:icon="@drawable/ic_refresh_white"
                app:iconTint="@color/da_accent"
                android:contentDescription="@string/refresh" />
        </LinearLayout>

        <!-- SECTION 1: PAIRED PHONES -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/paired_phones_header"
            android:textColor="@color/da_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <LinearLayout
            android:id="@+id/paired_devices_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/no_paired_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="@drawable/da_card"
            android:text="@string/no_paired_devices_found"
            android:textColor="@color/da_muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- SECTION 2: AVAILABLE / NEARBY PHONES (UNPAIRED) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/available_phones_header"
                android:textColor="@color/da_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <ProgressBar
                android:id="@+id/scan_progress_spinner"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/da_accent"
                android:visibility="visible" />

            <TextView
                android:id="@+id/scan_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/scanning_nearby"
                android:textColor="@color/da_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/unpaired_devices_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/no_unpaired_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="@drawable/da_card"
            android:text="@string/make_phone_discoverable_hint"
            android:textColor="@color/da_muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Pairing status banner (shown during active pairing) -->
        <LinearLayout
            android:id="@+id/pairing_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="14dp"
            android:background="@drawable/da_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/da_accent" />

            <TextView
                android:id="@+id/pairing_status_text"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textColor="@color/da_text"
                android:textSize="14sp"
                android:text="@string/pairing_in_progress" />
        </LinearLayout>

        <!-- Actions -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_bt_settings"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:text="@string/da_system_settings"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:textColor="@color/da_text"
            app:strokeColor="@color/da_border"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_picker"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="@string/cancel"
            android:textColor="@color/da_muted"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>
