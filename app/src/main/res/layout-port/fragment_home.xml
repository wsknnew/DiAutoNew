<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/da_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_android_auto"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/da_brand"
                android:textSize="24sp"
                android:textColor="@color/da_text"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_pill_translucent"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/status_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:src="@drawable/shape_dot_green"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/connection_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/da_ready"
                    android:textColor="@color/da_text"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Audio Routing Quick Toggle Pill -->
            <LinearLayout
                android:id="@+id/audio_mode_button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_translucent"
                android:paddingHorizontal="10dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/audio_mode_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_da_audio"
                    app:tint="@color/da_accent"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/audio_mode_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/audio_mode_car_bt"
                    android:textColor="@color/da_text"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/theme_toggle_button"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                app:icon="@drawable/ic_da_theme"
                app:iconTint="@color/da_text"
                android:contentDescription="@string/da_theme_settings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exit_button"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="@string/da_close"
                android:textSize="14sp"
                android:textColor="@color/da_muted" />
        </LinearLayout>

        <!-- Primary Cockpit Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/da_card"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/da_wireless"
                android:textSize="12sp"
                android:textColor="@color/da_accent"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/connection_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/da_ready"
                android:textSize="22sp"
                android:textColor="@color/da_text"
                android:fontFamily="sans-serif-medium"
                android:accessibilityLiveRegion="polite" />

            <TextView
                android:id="@+id/connection_step_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/step_1_bt"
                android:textSize="13sp"
                android:textColor="@color/da_accent"
                android:visibility="gone" />

            <!-- Active Phone Pill / Selector Bar -->
            <LinearLayout
                android:id="@+id/device_info_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/da_card_inner"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:gravity="center_vertical"
                android:visibility="visible">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_phone"
                    app:tint="@color/da_accent"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/preferred_device_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/da_device"
                    android:textColor="@color/da_text"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/btn_switch_device"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_translucent"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="@string/da_switch_phone"
                    android:textColor="@color/da_accent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Auto-Connect Countdown Banner -->
            <LinearLayout
                android:id="@+id/auto_connect_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill_translucent"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/auto_connect_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Auto-connecting in 4s…"
                    android:textColor="@color/da_accent"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/btn_cancel_auto_connect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="@string/cancel"
                    android:textColor="@color/da_text"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/wifi_button"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="14dp"
                android:text="@string/da_connect"
                android:textSize="18sp"
                android:textAllCaps="false"
                android:gravity="center"
                android:textColor="@color/da_background"
                app:backgroundTint="@color/da_accent"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_android_auto"
                app:iconTint="@color/da_background"
                app:iconSize="26dp"
                app:iconGravity="textStart"
                app:iconPadding="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_connect"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="@string/cancel_connecting"
                android:textColor="@color/da_muted"
                app:icon="@drawable/ic_close_white"
                app:iconTint="@color/da_muted"
                app:iconPadding="4dp"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/wifi_hint_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/da_hint"
                android:textSize="12sp"
                android:textColor="@color/da_muted" />
        </LinearLayout>

        <!-- Secondary Bento Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <!-- 1. Wired USB Action Card -->
            <LinearLayout
                android:id="@+id/usb_button"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/da_card"
                android:paddingHorizontal="18dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_usb_white"
                    app:tint="@color/da_accent"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/da_wired_usb"
                        android:textColor="@color/da_text"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/da_wired_usb_hint"
                        android:textColor="@color/da_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. Phone Hotspot Mode Action Card -->
            <LinearLayout
                android:id="@+id/hotspot_button"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/da_card"
                android:paddingHorizontal="18dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_wifi"
                    app:tint="@color/da_accent"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/da_phone_hotspot"
                        android:textColor="@color/da_text"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/da_phone_hotspot_hint"
                        android:textColor="@color/da_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. Settings & Preferences Card -->
            <LinearLayout
                android:id="@+id/settings_button"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/da_card"
                android:paddingHorizontal="18dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_settings_white"
                    app:tint="@color/da_accent"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/da_preferences_title"
                        android:textColor="@color/da_text"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/da_preferences_desc"
                        android:textColor="@color/da_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
